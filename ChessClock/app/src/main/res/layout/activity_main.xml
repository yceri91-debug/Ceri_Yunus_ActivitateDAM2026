<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1419"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="14dp"
    tools:context=".MainActivity">

    <!-- Jucator 2 (sus, rotit cu 180 de grade) -->
    <FrameLayout
        android:id="@+id/FL_jucator2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_panel_idle"
        android:clickable="true"
        android:focusable="true"
        android:rotation="180">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/TV_nume2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.2"
                android:text="NEGRU"
                android:textColor="#B0BEC5"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/TV_timp2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="10:00"
                android:textColor="#FFFFFF"
                android:textSize="84sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bara de control -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/BTN_reset"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#37474F"
            android:text="Reset"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/BTN_setari"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="#1976D2"
            android:text="Setări"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/BTN_pauza"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="#FFB300"
            android:text="Pauză"
            android:textColor="#1A1A1A" />
    </LinearLayout>

    <!-- Jucator 1 (jos) -->
    <FrameLayout
        android:id="@+id/FL_jucator1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_panel_idle"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/TV_nume1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.2"
                android:text="ALB"
                android:textColor="#B0BEC5"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/TV_timp1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="10:00"
                android:textColor="#FFFFFF"
                android:textSize="84sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>