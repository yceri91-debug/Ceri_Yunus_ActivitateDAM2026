<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1419"
    android:fitsSystemWindows="true"
    tools:context=".SetariActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Setări ceas"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.15"
            android:text="PRESETĂRI"
            android:textColor="#78909C"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/BTN_blitz"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_preset"
            android:text="Blitz  3 + 2"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/BTN_rapid"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_preset"
            android:text="Rapid  10 + 0"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/BTN_clasic"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_preset"
            android:text="Clasic  90 + 30"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.15"
            android:text="PERSONALIZAT"
            android:textColor="#78909C"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/ET_minute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Minute per jucător"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#607D8B" />

        <EditText
            android:id="@+id/ET_increment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Increment (secunde)"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#607D8B" />

        <Button
            android:id="@+id/BTN_aplica"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#43A047"
            android:text="Aplică"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />
    </LinearLayout>
</ScrollView>